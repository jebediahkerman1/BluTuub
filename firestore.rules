rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId && request.resource.data.keys().hasOnly(['displayName', 'username', 'avatarColor', 'createdAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
